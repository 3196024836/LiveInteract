<Window x:Class="LiveInteract.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="直播互动工具箱 · LiveInteract" Width="1400" Height="900" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen">
 <Grid Background="{StaticResource CanvasBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101923" BorderBrush="#273545" BorderThickness="0,0,1,0">
   <Grid Margin="20,30,20,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Border Width="34" Height="34" CornerRadius="9" Background="#79E0C8" Margin="0,0,10,0"><TextBlock Text="↯" FontSize="27" FontWeight="Bold" Foreground="#102820" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="LIVE INTERACT" FontFamily="Segoe UI" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/></StackPanel><TextBlock Text="直播互动工具箱" Foreground="#A2B2C2" FontSize="13" Margin="0,3,0,28"/></StackPanel>
    <ListBox x:Name="Navigation" Grid.Row="1" SelectedIndex="0" SelectionChanged="NavigationChanged" FontSize="15"><ListBoxItem Content="开播准备"/><ListBoxItem Content="触发规则"/><ListBoxItem Content="游戏功能库"/><ListBoxItem Content="消息与队列"/><ListBoxItem Content="Mod 与存档"/><ListBoxItem Content="画面与设置"/></ListBox>
    <StackPanel Grid.Row="3"><Border BorderBrush="#2B3B4D" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel><TextBlock Text="当前适配" Style="{StaticResource MutedText}"/><TextBlock Text="Hollow Knight: Silksong" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock Text="Steam / Windows x64" Style="{StaticResource MutedText}"/></StackPanel></Border><TextBlock Text="本地运行 · 无订阅" Foreground="#79E0C8" FontSize="12" Margin="0,20,0,5"/><TextBlock x:Name="VersionText" Text="v0.7.2 · 本地预发布" Style="{StaticResource MutedText}"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
   <Border Grid.Row="0" BorderBrush="#273545" BorderThickness="0,0,0,1" Padding="28,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="开播准备" FontSize="24" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Ellipse x:Name="GameDot" Fill="#D4A965" Width="7" Height="7" Margin="0,0,7,0"/><TextBlock x:Name="GameStatusText" Text="正在检测游戏环境" FontSize="12" Foreground="#A2B2C2"/><TextBlock Text="  /  " Foreground="#607386"/><TextBlock x:Name="SourceStatusText" Text="直播未连接" FontSize="12" Foreground="#A2B2C2"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="LiveButton" Content="开启互动" Style="{StaticResource PrimaryButton}" Click="ToggleLive" Margin="0,0,10,0" MinWidth="112"/><Button Content="紧急停止 / 恢复" Style="{StaticResource DangerButton}" Click="EmergencyClick" ToolTip="取消组合和待执行动作，恢复临时效果；不撤销永久修改。"/></StackPanel></Grid></Border>
   <TabControl x:Name="Pages" SelectedIndex="0" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
    <TabItem Header="开播准备"><ScrollViewer><StackPanel Margin="30,26,30,24">
     <Grid Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="三步准备好，开播就能互动。" FontSize="29" FontWeight="SemiBold" Margin="0,2,0,12"/><TextBlock Text="功能由你选择，触发由你配置。这里不预设玩法。" Foreground="#B5C4D1" FontSize="15"/><Border Background="#19352F" CornerRadius="4" Padding="10,5" HorizontalAlignment="Left" Margin="0,18,0,0"><TextBlock x:Name="CatalogCountText" Foreground="#91EAD2" FontSize="12" Text="正在载入动作目录"/></Border></StackPanel><Border Grid.Column="1" Background="#151F29" BorderBrush="#2A3C49" BorderThickness="1" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="本次会话" Foreground="#A2B2C2" FontSize="12"/><TextBlock x:Name="SuccessCount" Text="0" FontFamily="Segoe UI" FontSize="44" FontWeight="Light" Margin="0,5,0,0"/><TextBlock Text="游戏确认已执行" Foreground="#A2B2C2" FontSize="12"/><TextBlock x:Name="InputCount" Text="真实事件 0   ·   模拟 0" Foreground="#A2B2C2" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border></Grid>
     <Border BorderBrush="#2B3B4D" BorderThickness="0,1,0,1" Padding="0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="01" Foreground="#79E0C8" FontFamily="Segoe UI" FontSize="24"/><StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="准备游戏" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="PrepareSummary" Text="自动检测游戏、加载器与专用 Mod。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PrepareButton" Content="一键准备游戏" Style="{StaticResource PrimaryButton}" Click="PrepareGameClick" Margin="0,0,8,0"/><Button Content="启动游戏" Click="LaunchGameClick"/></StackPanel></Grid></Border>
     <Border BorderBrush="#2B3B4D" BorderThickness="0,0,0,1" Padding="0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="02" Foreground="#79E0C8" FontFamily="Segoe UI" FontSize="24"/><StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="连接直播间（抖音 / 哔哩哔哩）" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="在内置窗口选择平台并填写本人直播间地址；登录和验证由你完成。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="2" Content="连接直播间" Click="ConnectRoomClick" VerticalAlignment="Center"/></Grid></Border>
     <Border BorderBrush="#2B3B4D" BorderThickness="0,0,0,1" Padding="0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="03" Foreground="#79E0C8" FontFamily="Segoe UI" FontSize="24"/><StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="配置你自己的触发规则" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="RuleSummary" Text="从弹幕、礼物、点赞到游戏动作，按你的想法组合。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="2" Content="创建触发规则" Click="NewRuleClick" VerticalAlignment="Center"/></Grid></Border>
     <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开播前，先在本机试一下" Style="{StaticResource SectionTitle}"/><TextBlock Text="模拟的是观众输入，命中的规则会真实操作游戏。永久修改仍受保护。" Style="{StaticResource MutedText}"/><StackPanel Orientation="Horizontal" Margin="0,13,0,8"><ComboBox x:Name="SimType" Width="100" Margin="0,0,8,0"/><TextBox x:Name="SimText" Width="145" Text="回血" Margin="0,0,8,0" ToolTip="弹幕内容或礼物名称"/><TextBox x:Name="SimCount" Width="64" Text="1" ToolTip="数量"/></StackPanel><Button Content="发送一次测试输入" Click="SimulateClick" HorizontalAlignment="Left"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="最近执行" Style="{StaticResource SectionTitle}"/><Border Background="#151E29" CornerRadius="7" Padding="16"><TextBlock x:Name="LastActionText" Text="尚未执行动作。先准备游戏，再手动测试功能或规则。" Foreground="#B6C7D3" LineHeight="24"/></Border></StackPanel></Grid>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="触发规则"><Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="使用内置方案" Click="UseBuiltinProfileClick" Margin="0,0,8,0"/><Button Content="礼物绑定" Click="GiftBindingsClick" Margin="0,0,8,0"/><Button Content="读取配置文件" Click="LoadDefaultProfileClick" Margin="0,0,10,0"/><Button Content="从文件读取" Click="ImportRulesClick" Margin="0,0,8,0"/><Button Content="导出" Click="ExportRulesClick"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="＋ 新建规则" Style="{StaticResource PrimaryButton}" Click="NewRuleClick" Margin="0,0,8,0"/><Button Content="编辑" Click="EditRuleClick" Margin="0,0,8,0"/><Button Content="复制" Click="CopyRuleClick" Margin="0,0,8,0"/><Button Content="删除" Click="DeleteRuleClick"/></StackPanel></DockPanel><TextBlock x:Name="RulesHint" Grid.Row="1" Text="规则可以单独配置。导入的规则默认关闭，不会自动执行。" Style="{StaticResource MutedText}" Margin="0,14,0,16"/><DataGrid x:Name="RulesGrid" Grid.Row="2" IsReadOnly="True" MouseDoubleClick="EditRuleClick"><DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/><DataGridTextColumn Header="规则名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="触发条件" Binding="{Binding Trigger}" Width="220"/><DataGridTextColumn Header="动作" Binding="{Binding Actions}" Width="200"/><DataGridTextColumn Header="冷却" Binding="{Binding Cooldown}" Width="80"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="启用 / 停用选中规则" Click="RuleToggleClick" Margin="0,0,10,0"/><Button Content="↑ 上移" Click="RuleUpClick" Margin="0,0,8,0"/><Button Content="↓ 下移" Click="RuleDownClick"/><TextBlock Text="  修改保存后立即应用；总开关仍由你控制。" VerticalAlignment="Center" Foreground="#A2B2C2" FontSize="12"/></StackPanel></Grid></TabItem>
    <TabItem Header="游戏功能库"><Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><ComboBox x:Name="CategoryFilter" Width="150" DockPanel.Dock="Right" SelectionChanged="FilterActions" Margin="12,0,0,0"/><TextBlock Text="搜索功能" DockPanel.Dock="Left" Foreground="#AFC6D5" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="ActionSearch" TextChanged="FilterActions" ToolTip="搜索功能名称、分类、说明或内部 ID"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><ListBox x:Name="ActionsList" SelectionChanged="ActionSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding Category}" DockPanel.Dock="Right" Foreground="#90ABBA" FontSize="12" Margin="16,0,0,0"/><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Description}" Foreground="#9EB2C2" FontSize="12" Margin="0,6,0,1" LineHeight="20"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Column="2" Background="#151F2B" CornerRadius="8" Padding="20"><ScrollViewer><StackPanel><TextBlock x:Name="ActionNameText" Text="选择一个游戏功能" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ActionDescriptionText" Style="{StaticResource MutedText}" Margin="0,10,0,12"/><TextBlock x:Name="ActionRiskText" Foreground="#EABB89" FontSize="13" Margin="0,0,0,12"/><TextBlock Text="参数" FontSize="13" Foreground="#9DB3C3" Margin="0,8,0,12"/><StackPanel x:Name="ManualParameters"/><Button Content="在游戏中测试此功能" Style="{StaticResource PrimaryButton}" Click="TestActionClick" Margin="0,20,0,8"/><Button Content="用此功能创建规则" Click="NewRuleFromActionClick"/><TextBlock x:Name="ManualResultText" Foreground="#BBD4DB" LineHeight="22" Margin="0,16,0,0"/><TextBlock Text="目录表示代码已实现；游戏端回执与实际玩法效果的验收分开记录。" Style="{StaticResource MutedText}" Margin="0,18,0,0"/></StackPanel></ScrollViewer></Border></Grid></Grid></TabItem>
    <TabItem Header="消息与队列"><Grid Margin="28,24">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel Margin="0,0,0,12"><ComboBox x:Name="QueueViewFilter" Width="145" Margin="0,0,10,8" SelectionChanged="QueueFilterChanged"/><ComboBox x:Name="QueueSourceFilter" Width="130" Margin="0,0,10,8" SelectionChanged="QueueFilterChanged"/><ComboBox x:Name="QueueStateFilter" Width="135" Margin="0,0,10,8" SelectionChanged="QueueFilterChanged"/><TextBlock Text="搜索" Foreground="#A5BDCB" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBox x:Name="QueueSearch" Width="260" Margin="0,0,10,8" ToolTip="搜索触发者、效果、弹幕或错误原因" TextChanged="QueueFilterChanged"/><CheckBox x:Name="QueueAutoRefresh" Content="实时刷新" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,8"/></WrapPanel>
<WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button Content="恢复上次未完成队列" Click="ResumeQueueClick" Margin="0,0,10,6"/><Button Content="核对选中的未知回执" Click="CheckUnknownClick" Margin="0,0,10,6"/><Button Content="重解析待核对帧" Click="RetryFramesClick" Margin="0,0,10,6"/><Button Content="导出脱敏诊断" Click="ExportDiagnosticsClick" Margin="0,0,0,6"/></WrapPanel>
<Border x:Name="ConsoleErrorBanner" Grid.Row="2" Background="#35262B" BorderBrush="#754B50" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Right" Content="清除提示" Click="ClearErrorClick" Margin="12,0,0,0"/><TextBlock x:Name="ConsoleErrorText" Foreground="#FFBEA8" TextWrapping="Wrap"/></DockPanel></Border>
<DataGrid x:Name="QueueGrid" Grid.Row="3" IsReadOnly="True" RowHeight="NaN" SelectionMode="Single" MouseDoubleClick="QueueDetailsClick"><DataGrid.Columns>
<DataGridTextColumn Header="收到时间" Binding="{Binding LocalAt, StringFormat=HH:mm:ss}" Width="85"/><DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="65"/><DataGridTextColumn Header="触发者" Binding="{Binding Triggerer}" Width="115"/><DataGridTextColumn Header="效果" Binding="{Binding Effect}" Width="190"/><DataGridTextColumn Header="数量 / 结果" Binding="{Binding Progress}" Width="205"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8"/><Setter Property="ToolTip" Value="{Binding Progress}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="95"/><DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
</DataGrid.Columns></DataGrid>
<DataGrid x:Name="LogGrid" Grid.Row="3" IsReadOnly="True" RowHeight="NaN" Visibility="Collapsed" MouseDoubleClick="InputDetailsClick"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding At, StringFormat=HH:mm:ss}" Width="85"/><DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="65"/><DataGridTextColumn Header="状态 / 类型" Binding="{Binding StateText}" Width="155"/><DataGridTextColumn Header="内容与原因" Binding="{Binding Message}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,9"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
<TextBlock x:Name="QueueOverviewText" Grid.Row="4" Text="输入与队列先保存到本机。筛选仅改变显示；待核对的结果不会盲目重放。" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
</Grid></TabItem>
    <TabItem Header="Mod 与存档"><ScrollViewer><StackPanel Margin="28,24"><TextBlock Text="游戏环境" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GamePathBox"/><Button Grid.Column="1" Content="选择目录" Click="ChooseGameClick" Margin="10,0,0,0"/><Button Grid.Column="2" Content="重新检测" Click="DetectGameClick" Margin="10,0,0,0"/></Grid><TextBlock x:Name="GameDetailsText" Foreground="#B5C7D4" LineHeight="24" Margin="0,14,0,20"/><WrapPanel><Button Content="一键安装 / 修复" Style="{StaticResource PrimaryButton}" Click="PrepareGameClick" Margin="0,0,10,10"/><Button Content="启用 Mod" Click="EnableModClick" Margin="0,0,10,10"/><Button Content="停用 Mod" Click="DisableModClick" Margin="0,0,10,10"/><Button Content="卸载本工具 Mod" Style="{StaticResource DangerButton}" Click="UninstallModClick" Margin="0,0,10,10"/><Button Content="打开游戏目录" Click="OpenGameFolderClick" Margin="0,0,0,10"/></WrapPanel><Border BorderBrush="#2B3B4D" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,23,0,0"><StackPanel><TextBlock Text="存档备份与恢复" Style="{StaticResource SectionTitle}"/><TextBlock Text="只在游戏关闭时备份。恢复前会保留当前存档，可再次撤销恢复；不会删除备份。" Style="{StaticResource MutedText}"/><ComboBox x:Name="BackupList" Margin="0,16,0,12"/><WrapPanel><Button Content="立即备份" Click="BackupClick" Margin="0,0,10,0"/><Button Content="恢复选中备份" Click="RestoreBackupClick" Margin="0,0,10,0"/><Button Content="打开备份目录" Click="OpenBackupFolderClick"/></WrapPanel><TextBlock x:Name="BackupStatusText" Foreground="#B9D8CF" Margin="0,14,0,0" LineHeight="23"/></StackPanel></Border><Border BorderBrush="#2B3B4D" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="兼容与维护" Style="{StaticResource SectionTitle}"/><TextBlock Text="仅管理本工具的文件。已存在的加载器和其他 Mod 会保留；游戏运行中可安排退出后自动维护，不会强制结束游戏。" Style="{StaticResource MutedText}"/><TextBlock x:Name="MaintenanceStatusText" Foreground="#E9BB88" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="画面与设置"><ScrollViewer><StackPanel Margin="28,24" MaxWidth="850" HorizontalAlignment="Left"><TextBlock Text="可选直播提示" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="GameOverlayCheck" Content="游戏内渐隐触发队列与怪物触发者名字"/><CheckBox x:Name="BrowserOverlayCheck" Content="启用 OBS 等软件使用的透明浏览器源"/><CheckBox x:Name="HideNamesCheck" Visibility="Collapsed" Content="在提示和记录中隐藏昵称"/><TextBlock Text="透明浏览器源地址" Style="{StaticResource MutedText}" Margin="0,16,0,6"/><DockPanel><Button Content="复制地址" DockPanel.Dock="Right" Click="CopyOverlayClick" Margin="8,0,0,0"/><TextBox x:Name="OverlayUrlBox" IsReadOnly="True" MinWidth="400"/></DockPanel><TextBlock Text="在 OBS 中添加“浏览器”源，设置画布宽高。它只用于展示，不能远程控制游戏。" Style="{StaticResource MutedText}" Margin="0,8,0,15"/><WrapPanel><Button Content="发送展示预览" Click="OverlayPreviewClick" Margin="0,0,10,0"/><Button Content="在浏览器查看" Click="OpenOverlayClick" Margin="0,0,10,0"/><Button Content="生成当前直播图" Click="GeneratePosterClick" ToolTip="按当前启用的规则生成透明 PNG 直播图，礼物图标随包内置"/></WrapPanel><TextBlock Text="直播图按当前规则实时生成：触发词与效果都来自你正在用的配置，改完规则再点一次即可。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><Grid Margin="0,20,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="160"/><ColumnDefinition Width="170"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="字号" Style="{StaticResource MutedText}"/><TextBox x:Name="OverlayFontBox" Text="22" Margin="0,7,20,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="停靠位置" Style="{StaticResource MutedText}"/><ComboBox x:Name="CornerBox" Margin="0,7,20,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="主色（#RRGGBB）" Style="{StaticResource MutedText}"/><TextBox x:Name="AccentBox" Text="#79E0C8" Margin="0,7,20,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="本机展示端口" Style="{StaticResource MutedText}"/><TextBox x:Name="PortBox" Text="17573" Margin="0,7,0,0"/></StackPanel></Grid><TextBlock Text="透明源通知秒数" Style="{StaticResource MutedText}"/><TextBox x:Name="BrowserDurationBox" Text="6" Width="100" HorizontalAlignment="Left" Margin="0,7,0,10"/><WrapPanel><CheckBox x:Name="BrowserSourceCheck" Content="显示来源" Margin="0,0,18,0"/><CheckBox x:Name="BrowserResultCheck" Content="显示结果" Margin="0,0,18,0"/><CheckBox x:Name="BrowserEffectsCheck" Content="剩余效果" Margin="0,0,18,0"/><CheckBox x:Name="BrowserProgressCheck" Content="累计进度"/></WrapPanel><Expander Header="游戏内提示外观（可独立设置）" Foreground="#B8D2DE" Margin="0,22,0,24"><StackPanel Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="165"/><ColumnDefinition Width="165"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="游戏内字号" Style="{StaticResource MutedText}"/><TextBox x:Name="GameFontBox" Text="18" Margin="0,7,16,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="位置" Style="{StaticResource MutedText}"/><ComboBox x:Name="GameCornerBox" Margin="0,7,16,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="文字主色" Style="{StaticResource MutedText}"/><TextBox x:Name="GameAccentBox" Text="#D9F9EF" Margin="0,7,16,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="通知秒数" Style="{StaticResource MutedText}"/><TextBox x:Name="GameDurationBox" Text="5" Margin="0,7,0,0"/></StackPanel></Grid><WrapPanel Margin="0,15,0,0"><CheckBox x:Name="GameSourceCheck" Content="显示来源" Margin="0,0,18,0"/><CheckBox x:Name="GameResultCheck" Content="显示结果" Margin="0,0,18,0"/><CheckBox x:Name="GameEffectsCheck" Content="剩余效果" Margin="0,0,18,0"/><CheckBox x:Name="GameProgressCheck" Content="累计进度"/></WrapPanel></StackPanel></Expander><TextBlock Text="版本与更新" Style="{StaticResource SectionTitle}"/><DockPanel Margin="0,8,0,8"><Button Content="检查更新" Click="CheckUpdateClick" DockPanel.Dock="Left" Margin="0,0,14,0"/><CheckBox x:Name="AutoUpdateCheck" Content="启动时自动检查并提示更新" VerticalAlignment="Center" Checked="AutoUpdateChanged" Unchecked="AutoUpdateChanged"/></DockPanel><TextBl