<Window x:Class="LiveInteract.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="花花直播互动" Width="1400" Height="900" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen">
 <Grid Background="{StaticResource CanvasBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#151F19" BorderBrush="#2F4135" BorderThickness="0,0,1,0">
   <Grid Margin="18,28,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22">
     <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <Border Width="42" Height="42" CornerRadius="14" Background="#C2F1D2" Margin="0,0,12,0">
       <TextBlock Text="花" FontSize="24" FontWeight="Bold" Foreground="#163A2B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="花花" FontSize="24" FontWeight="Bold"/><TextBlock Text="LIVE INTERACTION" FontFamily="Segoe UI" FontSize="9" Foreground="#90AC9D"/></StackPanel>
     </StackPanel>
     <TextBlock Text="直播互动 · 一起玩才有意思" Foreground="#A8BAAD" FontSize="12"/>
    </StackPanel>
    <ListBox x:Name="Navigation" Grid.Row="1" SelectedIndex="0" SelectionChanged="NavigationChanged" FontSize="14" ItemContainerStyle="{StaticResource NavigationItem}"><ListBoxItem Content="开播准备" Tag="&#xE80F;"/><ListBoxItem Content="触发规则" Tag="&#xE713;"/><ListBoxItem Content="消息与队列" Tag="&#xE8F2;"/><ListBoxItem Content="画面与设置" Tag="&#xE771;"/><ListBoxItem Content="游戏功能库" Tag="&#xE7FC;" Style="{StaticResource NavigationAdvancedItem}"/><ListBoxItem Content="Mod 与存档" Tag="&#xE8B7;"/></ListBox>
    <StackPanel Grid.Row="3"><Border BorderBrush="#34473A" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel><TextBlock Text="当前适配" Style="{StaticResource MutedText}"/><TextBlock Text="Hollow Knight: Silksong" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock Text="Steam / Windows x64" Style="{StaticResource MutedText}"/></StackPanel></Border><TextBlock Text="花花出品 · 本地运行" Foreground="#C2F1D2" FontSize="12" Margin="0,20,0,5"/><TextBlock x:Name="VersionText" Text="本地预览版" Style="{StaticResource MutedText}"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
   <Border Grid.Row="0" BorderBrush="#2F4135" BorderThickness="0,0,0,1" Padding="28,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="开播准备" FontSize="24" FontWeight="SemiBold"/><Grid Margin="0,6,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="LivePill" Background="#2E3631" BorderBrush="#4A574E" BorderThickness="1" CornerRadius="11" Padding="10,2" Margin="0,0,12,0" MaxWidth="360" VerticalAlignment="Center"><TextBlock x:Name="LivePillText" Text="○ 互动已暂停 · 等待开启" FontSize="12" FontWeight="SemiBold" Foreground="#C3CCC5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></Border><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="GameDot" Fill="#D4A965" Width="7" Height="7" Margin="0,0,7,0"/><TextBlock x:Name="GameStatusText" Text="正在检测游戏环境" FontSize="12" Foreground="#A8BAAD" TextWrapping="NoWrap"/><TextBlock Text="  /  " Foreground="#607386"/><TextBlock x:Name="SourceStatusText" Text="直播未连接" FontSize="12" Foreground="#A8BAAD" TextWrapping="NoWrap"/></StackPanel></Grid></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="LiveButton" Content="开启互动" Style="{StaticResource PrimaryButton}" Click="ToggleLive" Margin="0,0,10,0" MinWidth="112"/><Button Content="紧急停止" Style="{StaticResource DangerButton}" Click="EmergencyClick" Margin="0,0,10,0" ToolTip="清空排队、撤销临时效果；不会自动恢复互动"/><Button x:Name="ClearSummonsButton" Content="清除召唤（F8）" Click="ClearSummonsClick" ToolTip="只清本工具的友军、敌军及待生成召唤，不动原场景怪物；不关闭互动"/></StackPanel></Grid></Border>
   <Border x:Name="ConsoleErrorBanner" Grid.Row="1" Background="#35262B" BorderBrush="#754B50" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="28,12,28,0" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Right" Content="清除提示" Click="ClearErrorClick" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="查看" Click="ViewErrorClick" Margin="12,0,0,0"/><TextBlock x:Name="ConsoleErrorText" Foreground="#FFBEA8" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
   <TabControl x:Name="Pages" SelectedIndex="0" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0">
    <TabItem Header="开播准备"><ScrollViewer><StackPanel Margin="30,20,30,24">
     <Border CornerRadius="14" Padding="22,12" Margin="0,0,0,16" BorderBrush="#30463C" BorderThickness="1">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#20392E" Offset="0"/><GradientStop Color="#17241F" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
        <TextBlock Text="弹幕入场，一起闯关。" FontSize="20" FontWeight="SemiBold" Foreground="#F5F5E9"/>
        <TextBlock Text="花花直播互动 / 丝之歌 · 观众送来帮手，也能制造一点小意外。" Foreground="#BED0C3" FontSize="12" Margin="0,4,0,0"/>
       </StackPanel>
       <Border Grid.Column="1" BorderBrush="#3A5144" BorderThickness="1,0,0,0" Padding="22,0,0,0" VerticalAlignment="Center" ToolTip="以游戏确认执行为准"><StackPanel>
        <StackPanel Orientation="Horizontal"><TextBlock Text="本场完成" Foreground="#B8CCBE" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="SuccessCount" Text="0" FontFamily="Segoe UI" FontSize="30" FontWeight="Light" Foreground="#E4F4DD" VerticalAlignment="Center"/></StackPanel>
        <TextBlock x:Name="InputCount" Text="真实事件 0   ·   模拟 0" Foreground="#9CB5A5" FontSize="12"/>
       </StackPanel></Border>
      </Grid>
     </Border>
     <Border BorderBrush="#34473A" BorderThickness="0,1,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="01" Foreground="#C2F1D2" FontFamily="Segoe UI" FontSize="24"/><StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="准备游戏环境" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="PrepareSummary" Text="自动检测游戏、加载器与专用 Mod。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PrepareButton" Content="一键准备游戏" Style="{StaticResource PrimaryButton}" Click="PrepareGameClick" Margin="0,0,8,0"/><Button Content="启动游戏" Click="LaunchGameClick"/></StackPanel></Grid></Border>
     <Border BorderBrush="#34473A" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="02" Foreground="#C2F1D2" FontFamily="Segoe UI" FontSize="24"/><StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="连接直播间" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="在内置窗口选择平台并填写本人直播间地址；登录和验证由你完成。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="2" Content="连接直播间" Click="ConnectRoomClick" VerticalAlignment="Center"/></Grid></Border>
     <Border BorderBrush="#34473A" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="03" Foreground="#C2F1D2" FontFamily="Segoe UI" FontSize="24"/><StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="选择互动玩法" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="RuleSummary" Text="读取内置配置，或为弹幕、礼物和点赞设置单个效果。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="2" Content="创建触发规则" Click="NewRuleClick" VerticalAlignment="Center"/></Grid></Border>
     <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开播前，先在本机试一下" Style="{StaticResource SectionTitle}"/><TextBlock Text="模拟的是观众输入，命中的规则会真实操作游戏。永久修改仍受保护。" Style="{StaticResource MutedText}"/><StackPanel Orientation="Horizontal" Margin="0,13,0,8"><ComboBox x:Name="SimType" Width="100" Margin="0,0,8,0"/><TextBox x:Name="SimText" Width="145" Text="回血" Margin="0,0,8,0" ToolTip="弹幕内容或礼物名称"/><TextBox x:Name="SimCount" Width="64" Text="1" ToolTip="数量"/></StackPanel><Button Content="发送一次测试输入" Click="SimulateClick" HorizontalAlignment="Left"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="最近执行" Style="{StaticResource SectionTitle}"/><Border Background="#1C2920" CornerRadius="12" Padding="18"><TextBlock x:Name="LastActionText" Text="尚未执行动作。先准备游戏，再手动测试功能或规则。" Foreground="{StaticResource MutedBrush}" LineHeight="24"/></Border></StackPanel></Grid>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="触发规则"><Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel>
<Button Content="＋ 新建规则" Style="{StaticResource PrimaryButton}" Click="NewRuleClick" Margin="0,0,8,8"/>
<Button Content="编辑" Click="EditRuleClick" Margin="0,0,8,8"/><Button Content="删除" Click="DeleteRuleClick" Margin="0,0,8,8"/><Button Content="礼物绑定" Click="GiftBindingsClick" Margin="0,0,8,8"/>
<Button Content="更多 ▾" Click="MoreRulesClick" Margin="0,0,0,8"><Button.ContextMenu><ContextMenu><MenuItem Header="复制选中规则" Click="CopyRuleClick"/><MenuItem Header="↑ 上移" Click="RuleUpClick"/><MenuItem Header="↓ 下移" Click="RuleDownClick"/><Separator/><MenuItem Header="使用内置方案" Click="UseBuiltinProfileClick"/><MenuItem Header="导入配置" Click="ImportRulesClick"/><MenuItem Header="导出配置" Click="ExportRulesClick"/></ContextMenu></Button.ContextMenu></Button>
</WrapPanel><TextBlock x:Name="RulesHint" Grid.Row="1" Text="规则可以单独配置。导入的规则默认关闭，不会自动执行。" Style="{StaticResource MutedText}" Margin="0,14,0,16"/><DataGrid x:Name="RulesGrid" Grid.Row="2" IsReadOnly="True" MouseDoubleClick="EditRuleClick"><DataGrid.Columns><DataGridTemplateColumn Header="启用" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="RuleEnabledClick" HorizontalAlignment="Center" Margin="0" ToolTip="勾选启用，取消停用；立即保存"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="规则名称" Binding="{Binding Name}" Width="3*"/><DataGridTextColumn Header="触发条件" Binding="{Binding Trigger}" Width="220"/><DataGridTextColumn Header="动作" Binding="{Binding Actions}" Width="2*"/><DataGridTextColumn Header="冷却" Binding="{Binding Cooldown}" Width="80"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" Text="勾选“启用”列即可启停规则；复制、顺序调整和导入导出在“更多”里。修改保存后立即应用，总开关仍由你控制。" Margin="0,14,0,0" Foreground="#A8BAAD" FontSize="12"/></Grid></TabItem>
    <TabItem Header="消息与队列"><Grid Margin="28,24">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel Margin="0,0,0,12"><ComboBox x:Name="QueueViewFilter" Width="145" Margin="0,0,10,8" SelectionChanged="QueueFilterChanged"/><ComboBox x:Name="QueueSourceFilter" Width="130" Margin="0,0,10,8" SelectionChanged="QueueFilterChanged"/><ComboBox x:Name="QueueStateFilter" Width="135" Margin="0,0,10,8" SelectionChanged="QueueFilterChanged"/><TextBlock Text="搜索" Foreground="#A5BDCB" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBox x:Name="QueueSearch" Width="260" Margin="0,0,10,8" ToolTip="搜索触发者、效果、弹幕或错误原因" TextChanged="QueueFilterChanged"/><CheckBox x:Name="QueueAutoRefresh" Content="实时刷新" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,8" Checked="QueueFilterChanged" Unchecked="QueueFilterChanged"/></WrapPanel>
<Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="恢复上次未完成队列" Click="ResumeQueueClick" VerticalAlignment="Top" Margin="0,0,18,0"/><Expander Grid.Column="1" Margin="0,9,0,0"><Expander.Header><TextBlock Text="高级 / 排查" Foreground="{StaticResource MutedBrush}"/></Expander.Header><WrapPanel Margin="0,10,0,0"><Button Content="核对选中的未知回执" Click="CheckUnknownClick" Margin="0,0,10,6"/><Button Content="重解析待核对帧" Click="RetryFramesClick" Margin="0,0,10,6"/><Button Content="导出脱敏诊断" Click="ExportDiagnosticsClick" Margin="0,0,0,6"/></WrapPanel></Expander></Grid>
<DataGrid x:Name="QueueGrid" Grid.Row="3" IsReadOnly="True" RowHeight="NaN" SelectionMode="Single" MouseDoubleClick="QueueDetailsClick"><DataGrid.Columns>
<DataGridTextColumn Header="收到时间" Binding="{Binding LocalAt, StringFormat=HH:mm:ss}" Width="85"/><DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="65"/><DataGridTextColumn Header="触发者" Binding="{Binding Triggerer}" Width="115"/><DataGridTextColumn Header="效果" Binding="{Binding Effect}" Width="190"/><DataGridTextColumn x:Name="ProgressColumn" Header="数量 / 结果" Width="160"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Progress}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="95"/><DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
</DataGrid.Columns></DataGrid>
<DataGrid x:Name="LogGrid" Grid.Row="3" IsReadOnly="True" RowHeight="NaN" Visibility="Collapsed" MouseDoubleClick="InputDetailsClick"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding At, StringFormat=HH:mm:ss}" Width="85"/><DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="65"/><DataGridTextColumn Header="状态 / 类型" Binding="{Binding StateText}" Width="155"/><DataGridTextColumn Header="内容与原因" Binding="{Binding Message}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="30">
 <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
  <Style.Triggers>
   <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=QueueGrid}" Value="Visible"/><Condition Binding="{Binding Items.Count, ElementName=QueueGrid}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
   <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=LogGrid}" Value="Visible"/><Condition Binding="{Binding Items.Count, ElementName=LogGrid}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
  </Style.Triggers>
 </Style></StackPanel.Style>
 <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#668973" HorizontalAlignment="Center" Margin="0,0,0,18"/>
 <TextBlock Text="当前筛选下没有记录" FontSize="18" Foreground="#D7E8D9" HorizontalAlignment="Center"/>
 <TextBlock Text="连接直播后，可在这里查看观众输入、执行结果和失败原因。" FontSize="13" Foreground="#A8BAAD" TextAlignment="Center" Margin="0,10,0,0"/>
 <TextBlock Text="已有互动时，也可以调整上方的来源、状态或关键词筛选。" FontSize="12" Foreground="#8BA494" TextAlignment="Center" Margin="0,6,0,0"/>
</StackPanel>
<TextBlock x:Name="QueueOverviewText" Grid.Row="4" Text="输入与队列先保存到本机。筛选仅改变显示；待核对的结果不会盲目重放。" Style="{StaticResource MutedText}" Margin="0,12,0,0" ToolTipService.ShowDuration="20000"/>
</Grid></TabItem>
    <TabItem Header="画面与设置"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer><StackPanel Margin="28,24" MaxWidth="850" HorizontalAlignment="Left" TextBoxBase.TextChanged="SettingsFieldChanged" ToggleButton.Checked="SettingsFieldChanged" ToggleButton.Unchecked="SettingsFieldChanged" Selector.SelectionChanged="SettingsFieldChanged"><TextBlock Text="可选直播提示" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="GameOverlayCheck" Content="游戏内渐隐触发队列与怪物触发者名字"/><CheckBox x:Name="FactionOutlineCheck" Content="召唤物本体描边：友方绿色、敌方红色"/><DockPanel Margin="0,6,0,6"><TextBlock Text="轮廓粗细（1～5像素）" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBox x:Name="FactionOutlineWidthBox" Text="2" Width="80" Margin="12,0,0,0" HorizontalAlignment="Left"/></DockPanel><TextBlock x:Name="FactionOutlineStatusText" Text="仅描出怪物轮廓，原颜色和动画保留；不依赖名字/队列开关。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/><CheckBox x:Name="BrowserOverlayCheck" Content="启用 OBS 等软件使用的透明浏览器源"/><CheckBox x:Name="HideNamesCheck" Visibility="Collapsed" Content="在提示和记录中隐藏昵称"/><TextBlock Text="透明浏览器源地址" Style="{StaticResource MutedText}" Margin="0,16,0,6"/><DockPanel><Button Content="复制地址" DockPanel.Dock="Right" Click="CopyOverlayClick" Margin="8,0,0,0"/><TextBox x:Name="OverlayUrlBox" IsReadOnly="True" MinWidth="400"/></DockPanel><TextBlock Text="在 OBS 中添加“浏览器”源，设置画布宽高。它只用于展示，不能远程控制游戏。" Style="{StaticResource MutedText}" Margin="0,8,0,15"/><WrapPanel><Button Content="发送展示预览" Click="OverlayPreviewClick" Margin="0,0,10,0"/><Button Content="在浏览器查看" Click="OpenOverlayClick" Margin="0,0,10,0"/><Button Content="生成当前直播图" Click="GeneratePosterClick" ToolTip="按当前启用的规则生成透明 PNG 直播图，礼物图标随包内置"/></WrapPanel><TextBlock Text="直播图按当前规则实时生成：触发词与效果都来自你正在用的配置，改完规则再点一次即可。" Style="{StaticResource MutedText}" Margin="0,8,0,22"/><TextBlock Text="执行保护" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="PersistentCheck" Content="本次会话允许永久资源、装备与能力修改" Checked="PersistentChanged" Unchecked="PersistentChanged"/><TextBlock Text="不会记住这项许可。导入配置不能替你开启；紧急停止也不能撤销已写入的永久修改。" Style="{StaticResource MutedText}" Margin="0,0,0,22"/><TextBlock Text="版本与更新" Style="{StaticResource SectionTitle}"/><DockPanel Margin="0,0,0,8"><Button Content="检查更新" Click="CheckUpdateClick" DockPanel.Dock="Left" Margin="0,0,14,0"/><CheckBox x:Name="AutoUpdateCheck" Content="启动时自动检查并提示更新" VerticalAlignment="Center" Checked="AutoUpdateChanged" Unchecked="AutoUpdateChanged"/></DockPanel><TextBlock x:Name="UpdateStatusText" Style="{StaticResource MutedText}" Text="当前版本" TextWrapping="Wrap" Margin="0,0,0,20"/><TextBlock Text="快捷键" Style="{StaticResource SectionTitle}"/><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="修改" Tag="pause" Click="ChangeHotkeyClick"/><TextBlock x:Name="PauseHotkeyText" Text="Ctrl+Alt+F10 · 暂停 / 恢复新触发" VerticalAlignment="Center" Margin="0,0,20,0"/></DockPanel><DockPanel><Button DockPanel.Dock="Right" Content="修改" Tag="emergency" Click="ChangeHotkeyClick"/><TextBlock x:Name="EmergencyHotkeyText" Text="Ctrl+Alt+F12 · 紧急停止" VerticalAlignment="Center" Margin="0,0,20,0"/></DockPanel><DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="修改" Tag="clearSummons" Click="ChangeHotkeyClick"/><TextBlock x:Name="ClearSummonsHotkeyText" Text="F8 · 清除全部召唤物（双方）" VerticalAlignment="Center" Margin="0,0,20,0"/></DockPanel><TextBlock Text="游戏右下角显示清除键；只清本工具的友军、敌军及待生成召唤，不动原场景怪物。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBlock Text="注册冲突会显示在运行记录中，不会悄悄失效。" Style="{StaticResource MutedText}" Margin="0,8,0,22"/><Expander x:Name="AdvancedSettings" Margin="0,0,0,8"><Expander.Header><TextBlock Text="高级设置" FontSize="15" Foreground="#B8D2DE" ToolTip="外观细节、端口、召唤排队与性能保护"/></Expander.Header><StackPanel Margin="0,14,0,0"><TextBlock Text="透明源外观" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="160"/><ColumnDefinition Width="170"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="字号" Style="{StaticResource MutedText}"/><TextBox x:Name="OverlayFontBox" Text="22" Margin="0,7,20,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="停靠位置" Style="{StaticResource MutedText}"/><ComboBox x:Name="CornerBox" Margin="0,7,20,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="主色（#RRGGBB）" Style="{StaticResource MutedText}"/><TextBox x:Name="AccentBox" Text="#C2F1D2" Margin="0,7,20,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="本机展示端口" Style="{StaticResource MutedText}"/><TextBox x:Name="PortBox" Text="17573" Margin="0,7,0,0"/></StackPanel></Grid><TextBlock Text="透明源通知秒数" Style="{StaticResource MutedText}"/><TextBox x:Name="BrowserDurationBox" Text="6" Width="100" HorizontalAlignment="Left" Margin="0,7,0,10"/><WrapPanel><CheckBox x:Name="BrowserSourceCheck" Content="显示来源" Margin="0,0,18,0"/><CheckBox x:Name="BrowserResultCheck" Content="显示结果" Margin="0,0,18,0"/><CheckBox x:Name="BrowserEffectsCheck" Content="剩余效果" Margin="0,0,18,0"/><CheckBox x:Name="BrowserProgressCheck" Content="累计进度"/></WrapPanel><TextBlock Text="游戏内提示外观（可独立设置）" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="165"/><ColumnDefinition Width="165"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="游戏内字号" Style="{StaticResource MutedText}"/><TextBox x:Name="GameFontBox" Text="18" Margin="0,7,16,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="位置" Style="{StaticResource MutedText}"/><ComboBox x:Name="GameCornerBox" Margin="0,7,16,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="文字主色" Style="{StaticResource MutedText}"/><TextBox x:Name="GameAccentBox" Text="#D9F9EF" Margin="0,7,16,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="通知秒数" Style="{StaticResource MutedText}"/><TextBox x:Name="GameDurationBox" Text="5" Margin="0,7,0,0"/></StackPanel></Grid><WrapPanel Margin="0,15,0,0"><CheckBox x:Name="GameSourceCheck" Content="显示来源" Margin="0,0,18,0"/><CheckBox x:Name="GameResultCheck" Content="显示结果" Margin="0,0,18,0"/><CheckBox x:Name="GameEffectsCheck" Content="剩余效果" Margin="0,0,18,0"/><CheckBox x:Name="GameProgressCheck" Content="累计进度"/></WrapPanel><TextBlock Text="召唤排队与性能保护" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,10"/><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="165"/><ColumnDefinition Width="165"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="双方总上限（只）" Style="{StaticResource MutedText}"/><TextBox x:Name="SummonTotalLimitBox" Text="40" Margin="0,7,16,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="敌方额外上限（只）" Style="{StaticResource MutedText}"/><TextBox x:Name="SpawnLimitBox" Text="40" Margin="0,7,16,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="生成间隔（秒）" Style="{StaticResource MutedText}"/><TextBox x:Name="SummonIntervalBox" Text="0.5" Margin="0,7,16,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="排队容量（次触发）" Style="{StaticResource MutedText}"/><TextBox x:Name="SummonQueueCapacityBox" Text="200" Margin="0,7,0,0"/></StackPanel></Grid><TextBlock Text="超量按队列逐只补位；队列满时未入队任务留在控制台等待。上限为0表示该项不限，生成间隔为0表示不节流，可能卡顿。缩小上限或队列容量不会强删现有召唤和排队项。" Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="660" HorizontalAlignment="Left"/><CheckBox x:Name="SummonQueuePausedCheck" Content="暂停召唤补位（保留队列，保存并应用后生效）" Margin="0,10,0,0"/><TextBlock x:Name="SummonQueueStatusText" Text="游戏连接后显示场上数量和待生成数量" Foreground="#B3DCD0" Margin="0,8,0,0"/><TextBlock Text="关于更新" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,10"/><TextBlock Text="更新包来自本项目的 GitHub 发布；替换前会校验 SHA-256，只覆盖程序与载荷，不动存档、规则和浏览器登录数据。" Style="{StaticResource MutedText}"/></StackPanel></Expander></StackPanel></ScrollViewer><Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,12"><DockPanel><Button Content="保存并应用设置" Style="{StaticResource PrimaryButton}" Click="SaveSettingsClick" DockPanel.Dock="Left" VerticalAlignment="Center"/><TextBlock x:Name="SettingsDirtyText" Text="有未保存的修改" DockPanel.Dock="Left" Foreground="#E9BB88" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed"/><TextBlock x:Name="SettingsResultText" Foreground="#B3DCD0" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel></Border></Grid></TabItem>
    <TabItem Header="游戏功能库"><Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><ComboBox x:Name="CategoryFilter" Width="150" DockPanel.Dock="Right" SelectionChanged="FilterActions" Margin="12,0,0,0"/><TextBlock Text="搜索功能" DockPanel.Dock="Left" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="ActionSearch" TextChanged="FilterActions" ToolTip="搜索功能名称、分类、说明或内部 ID"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><ListBox x:Name="ActionsList" SelectionChanged="ActionSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding Category}" DockPanel.Dock="Right" Foreground="#90ABBA" FontSize="12" Margin="16,0,0,0"/><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,1" LineHeight="20"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20"><ScrollViewer><StackPanel><TextBlock x:Name="ActionNameText" Text="选择一个游戏功能" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ActionDescriptionText" Style="{StaticResource MutedText}" Margin="0,10,0,12"/><TextBlock x:Name="ActionRiskText" Foreground="#EABB89" FontSize="13" Margin="0,0,0,12"/><TextBlock Text="参数" FontSize="13" Foreground="#9DB3C3" Margin="0,8,0,12"/><StackPanel x:Name="ManualParameters"/><Button Content="在游戏中测试此功能" Style="{StaticResource PrimaryButton}" Click="TestActionClick" Margin="0,20,0,8"/><Button Content="用此功能创建规则" Click="NewRuleFromActionClick"/><TextBlock x:Name="ManualResultText" Foreground="#BBD4DB" LineHeight="22" Margin="0,16,0,0"/><TextBlock Text="测试后请核对游戏回执和实际效果。" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,18,0,0"/></StackPanel></ScrollViewer></Border></Grid></Grid></TabItem>
    <TabItem Header="Mod 与存档"><ScrollViewer><StackPanel Margin="28,24"><TextBlock Text="游戏环境" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GamePathBox"/><Button Grid.Column="1" Content="选择目录" Click="ChooseGameClick" Margin="10,0,0,0"/><Button Grid.Column="2" Content="重新检测" Click="DetectGameClick" Margin="10,0,0,0"/></Grid><TextBlock x:Name="GameDetailsText" Foreground="#B5C7D4" LineHeight="24" Margin="0,14,0,20"/><WrapPanel><Button Content="一键安装 / 修复" Style="{StaticResource PrimaryButton}" Click="PrepareGameClick" Margin="0,0,10,10"/><Button Content="启用 Mod" Click="EnableModClick" Margin="0,0,10,10"/><Button Content="停用 Mod" Click="DisableModClick" Margin="0,0,10,10"/><Button Content="卸载本工具 Mod" Style="{StaticResource DangerButton}" Click="UninstallModClick" Margin="0,0,10,10"/><Button Content="打开游戏目录" Click="OpenGameFolderClick" Margin="0,0,0,10"/></WrapPanel><Border BorderBrush="#34473A" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,23,0,0"><StackPanel><TextBlock Text="存档备份与恢复" Style="{StaticResource SectionTitle}"/><TextBlock Text="只在游戏关闭时备份。恢复前会保留当前存档，可再次撤销恢复；不会删除备份。" Style="{StaticResource MutedText}"/><ComboBox x:Name="BackupList" Margin="0,16,0,12"/><WrapPanel><Button Content="立即备份" Click="BackupClick" Margin="0,0,10,0"/><Button Content="恢复选中备份" Click="RestoreBackupClick" Margin="0,0,10,0"/><Button Content="打开备份目录" Click="OpenBackupFolderClick"/></WrapPanel><TextBlock x:Name="BackupStatusText" Foreground="#B9D8CF" Margin="0,14,0,0" LineHeight="23"/></StackPanel></Border><Border BorderBrush="#34473A" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="兼容与维护" Style="{StaticResource SectionTitle}"/><TextBlock Text="仅管理本工具的文件。已存在的加载器和其他 Mod 会保留；游戏运行中可安排退出后自动维护，不会强制结束游戏。" Style="{StaticResource MutedText}"/><TextBlock x:Name="MaintenanceStatusText" Foreground="#E9BB88" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
