<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
  <Product>花花直播互动</Product><Title>花花直播互动</Title><Description>花花的直播游戏互动工具</Description>
  <AssemblyName>LiveInteract</AssemblyName><RootNamespace>LiveInteract.Desktop</RootNamespace>
  <ApplicationIcon>Assets/LiveInteract.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
 </PropertyGroup>
 <ItemGroup><ProjectReference Include="../LiveInteract.Core/LiveInteract.Core.csproj" /><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" /></ItemGroup>
 <ItemGroup><Resource Include="Assets/LiveInteract.ico" /></ItemGroup>
 <ItemGroup>
  <EmbeddedResource Include="../../直播素材/官方礼物图标/heart.png" LogicalName="LiveInteract.Desktop.gift.heart.png" />
  <EmbeddedResource Include="../../直播素材/官方礼物图标/rose.png" LogicalName="LiveInteract.Desktop.gift.rose.png" />
  <EmbeddedResource Include="../../直播素材/官方礼物图标/lollipop.png" LogicalName="LiveInteract.Desktop.gift.lollipop.png" />
  <EmbeddedResource Include="../../直播素材/官方礼物图标/han.png" LogicalName="LiveInteract.Desktop.gift.han.png" />
 </ItemGroup>
 <ItemGroup><Content Include="../../profiles/*"><Link>profiles/%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content></ItemGroup>
</Project>